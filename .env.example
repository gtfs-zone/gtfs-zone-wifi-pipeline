# Local Garage from gtfs-zone-dev-stack, with its dev key for both buckets.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
RAW_S3_BUCKET=wifi-raw
RAW_S3_ACCESS_KEY=GK0123456789abcdef01234567
RAW_S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PUBLIC_S3_BUCKET=data.wifi.gtfs.zone
PUBLIC_S3_ACCESS_KEY=GK0123456789abcdef01234567
PUBLIC_S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional: TRANSITOUS_URL, WIFI_MIN_SESSIONS, WIFI_BIN_M, WIFI_EXCLUDED_SESSIONS
